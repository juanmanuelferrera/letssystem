# Copia este fichero a .env y ajusta lo que necesites.
# .env NO se versiona (ver .gitignore).

# Puerto y dirección de escucha (uso local)
PORT=4173
HOST=127.0.0.1

# Ruta del fichero SQLite (relativa a la raíz del proyecto o absoluta)
LETS_DB=data/lets.db

# Datos de ejemplo SOLO para pruebas en local (1 = sí, 0 = no).
# En producción no se usan: la instancia nace vacía y el admin crea su grupo.
SEED=0

# Idioma por defecto del sitio: es | en | fr | pt
LETS_LANG=es
